---
import BaseLayout from '../layouts/BaseLayout.astro'
import Scene3D from '../components/Scene3D'
---

<BaseLayout title="Mission Portfolio">
  <main style="max-width: 720px; margin: 0 auto; padding: 15vh 24px;">
    <p style="font-size: 11px; letter-spacing: 0.3em; color: var(--muted);">
      SECTOR 07 — ORION ARM
    </p>
    <h1 style="font-size: 72px; line-height: 1; margin: 24px 0;">
      Halo, dunia.
    </h1>
    <p style="color: rgba(245, 240, 232, 0.7);">
      Di bawah ini adalah test render 3D pertama.
    </p>

    <Scene3D client:only="react" />
  </main>
</BaseLayout>