---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { planets } from '../../data/planets'

export function getStaticPaths() {
  return planets.map((planet) => ({
    params: { id: planet.id },
    props: { planet },
  }))
}

const { planet } = Astro.props
const title = planet.name.charAt(0).toUpperCase() + planet.name.slice(1)
---

<BaseLayout title={`${title} — Mission Portfolio`}>
  <article class="pp">
    <header class="pp__bar">
      <a href="/" class="pp__back">
        <span aria-hidden>←</span>
        <span>Beranda</span>
      </a>
      <div class="pp__coords">
        ORBIT {planet.distance.toFixed(1)} AU
      </div>
      <div class="pp__codename">
        <span class="pp__dot" />
        ORION-{planet.name.toUpperCase()}
      </div>
    </header>

    <section class="pp__hero">
      <div class="pp__eyebrow">LAPORAN MISI // {planet.year}</div>
      <h1 class="pp__title">{title}</h1>
      <p class="pp__lead">{planet.summary}</p>
    </section>

    <dl class="pp__meta">
      <div>
        <dt>TAHUN</dt>
        <dd>{planet.year}</dd>
      </div>
      <div>
        <dt>PERAN</dt>
        <dd>{planet.role}</dd>
      </div>
      <div>
        <dt>DURASI</dt>
        <dd>{planet.duration}</dd>
      </div>
      <div>
        <dt>TEKNOLOGI</dt>
        <dd>{planet.stack.length} modul</dd>
      </div>
    </dl>

    <section class="pp__stack">
      <div class="pp__label">TEKNOLOGI</div>
      <ul>
        {planet.stack.map((s, i) => (
          <li>
            <em>{String(i + 1).padStart(2, '0')}</em>
            {s}
          </li>
        ))}
      </ul>
    </section>

    <footer class="pp__footer">
      <a href="/">← Kembali ke Beranda</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .pp {
    background: var(--bg);
    color: var(--ink);
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    min-height: 100vh;
    padding: 0 6vw;
    max-width: 1280px;
    margin: 0 auto;
  }

  .pp__bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 22px 0;
    border-bottom: 1px solid rgba(245, 240, 232, 0.08);
    font-size: 10px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }
  .pp__back {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.25s ease, gap 0.25s ease;
    justify-self: start;
  }
  .pp__back:hover { color: var(--accent); gap: 14px; }
  .pp__coords { color: var(--muted); justify-self: center; }
  .pp__codename {
    color: var(--muted);
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .pp__dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 10px var(--accent);
  }

  .pp__hero {
    padding: 12vh 0 8vh;
  }
  .pp__eyebrow {
    font-size: 10px;
    letter-spacing: 0.34em;
    color: var(--muted);
    margin-bottom: 28px;
  }
  .pp__title {
    font-family: 'Instrument Serif', Georgia, serif;
    font-weight: 400;
    font-size: clamp(64px, 10vw, 148px);
    line-height: 0.92;
    letter-spacing: -0.025em;
    margin: 0 0 32px;
  }
  .pp__lead {
    font-size: 15px;
    line-height: 1.7;
    color: rgba(245, 240, 232, 0.7);
    max-width: 46ch;
  }

  .pp__meta {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    padding: 36px 0;
    border-top: 1px solid rgba(245, 240, 232, 0.08);
    border-bottom: 1px solid rgba(245, 240, 232, 0.08);
    margin: 0;
  }
  .pp__meta dt {
    font-size: 9px;
    letter-spacing: 0.28em;
    color: var(--muted);
    margin-bottom: 10px;
  }
  .pp__meta dd {
    margin: 0;
    font-size: 14px;
    color: var(--ink);
  }

  .pp__label {
    font-size: 9px;
    letter-spacing: 0.32em;
    color: var(--muted);
    margin-bottom: 24px;
  }
  .pp__stack {
    padding: 6vh 0 8vh;
  }
  .pp__stack ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .pp__stack li {
    display: flex;
    gap: 24px;
    align-items: baseline;
    padding: 14px 0;
    border-bottom: 1px solid rgba(245, 240, 232, 0.06);
    font-size: 14px;
    color: rgba(245, 240, 232, 0.85);
  }
  .pp__stack li em {
    font-style: normal;
    font-size: 10px;
    letter-spacing: 0.24em;
    color: var(--accent);
    min-width: 30px;
  }

  .pp__footer {
    padding: 4vh 0 10vh;
    border-top: 1px solid rgba(245, 240, 232, 0.08);
  }
  .pp__footer a {
    color: var(--muted);
    text-decoration: none;
    font-size: 11px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    transition: color 0.25s ease;
  }
  .pp__footer a:hover { color: var(--accent); }

  @media (max-width: 900px) {
    .pp__meta { grid-template-columns: repeat(2, 1fr); }
    .pp__hero { padding: 8vh 0 5vh; }
  }
</style>